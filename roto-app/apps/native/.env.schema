# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=string(matches="^https?://")
EXPO_PUBLIC_SERVER_URL=

# The map style URL. `url()` rather than a custom `matches` pattern: varlock stringifies a
# function-valued attribute, so a hand-rolled validator reported "Value must start with
# function startsWith()" and refused to start Metro at all.
# @public @type=url(prependHttps=false)
EXPO_PUBLIC_TILE_URL=
